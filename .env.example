# Copy to .env and load with FP_DOTENV=1 for local development.
# In a container, set these as real environment variables instead.

# --- network ---------------------------------------------------------------
FP_HOST=127.0.0.1
FP_PORT=8080
FP_ARTIFACT_PORT=8081
# Must match the hostname users actually reach: feeds iframe src + frame-ancestors.
FP_ARTIFACT_BASE_URL=http://localhost:8081
# The origin the gallery is browsed at, which the artifact origin lists in
# frame-ancestors. Leave unset to derive it from FP_ARTIFACT_BASE_URL + FP_PORT.
# Set it whenever the browser reaches the gallery on a different port than FP_PORT
# (for example `podman run -p 18080:8080` -> http://localhost:18080), otherwise
# the browser refuses to frame the artifact and app pages show a blank box.
FP_GALLERY_BASE_URL=

# --- storage ---------------------------------------------------------------
FP_DATA_DIR=./data
FP_DB_FILENAME=funprompts.db

# --- worker / caps ---------------------------------------------------------
FP_WORKER_CONCURRENCY=2
FP_WORKER_POLL_INTERVAL_MS=1000
FP_JOB_MAX_ATTEMPTS=2
FP_JOB_TIMEOUT_S=120
FP_JOB_REPAIR_RETRIES=1
FP_MAX_PROMPT_CHARS=8000
FP_MAX_ARTIFACT_KB=200
FP_MAX_OUTPUT_TOKENS=8000
FP_MAX_COMPARISON_TARGETS=4

# --- auth (leave unset to have them generated into data/first-run.txt) -----
ADMIN_PASSWORD=
FP_SESSION_SECRET=
FP_SESSION_TTL_HOURS=24
FP_KEY_FILE=./data/keys/fernet.key
# Add the `Secure` flag to the session cookie. Leave off on a LAN over plain
# http; turn it on as soon as something TLS-terminating sits in front.
FP_COOKIE_SECURE=0
# Failed admin sign-ins allowed per client per hour.
FP_LOGIN_MAX_ATTEMPTS_PER_HOUR=10

# --- provider safety -------------------------------------------------------
# Comma-separated host:port allowlist for admin-configured endpoint base URLs.
FP_ENDPOINT_ALLOWLIST=localhost:11434,127.0.0.1:8000
FP_BLOCK_METADATA_IPS=1
FP_ALLOW_INSECURE_TLS=0
# Debug only: lets prompt-override markers through the detector.
FP_ALLOW_PROMPT_MARKERS=0
FP_RATE_LIMIT_PER_HOUR=0
FP_ALLOW_ORIGINS=

# --- boot ------------------------------------------------------------------
FP_SEED_ON_START=1
# The artifact origin (:8081) runs beside the gallery in the same process. Turn
# it off only if you put those bytes behind another server yourself.
FP_RUN_ARTIFACT_SERVER=1
# Where seed prompts and pre-built seed artifacts live (defaults: repo ./prompts
# and ./seed/apps; in the image these are under /srv/app).
FP_PROMPTS_DIR=./prompts
FP_SEED_APPS_DIR=./seed/apps
FP_LOG_LEVEL=DEBUG
